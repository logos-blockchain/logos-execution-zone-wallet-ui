class LEZWalletBackend
{
    PROP(bool isWalletOpen READONLY)
    PROP(bool isStartupResolved READONLY)
    // A wallet is saved here and waits for its password to open.
    PROP(bool needsPassword READONLY)
    PROP(QString configPath READONLY)
    PROP(QString storagePath READONLY)
    PROP(QString notice READONLY)
    PROP(int lastSyncedBlock READONLY)
    PROP(int currentBlockHeight READONLY)
    PROP(QString sequencerAddr READONLY)
    PROP(QString testnetUrl READONLY)
    PROP(QString localhostUrl READONLY)

    SLOT(QString createAccountPublic())
    SLOT(QString createAccountPrivate())
    SLOT(void refreshAccounts())
    SLOT(QString getBalance(QString accountIdHex, bool isPublic))
    SLOT(void refreshBalances())
    SLOT(QString getPublicAccountKey(QString accountIdHex))
    SLOT(QString getPrivateAccountKeys(QString accountIdHex))
    SLOT(bool syncToBlock(quint64 blockId))

    // Every send takes lez_core's per-call fee overrides ("" for the wallet's defaults) and
    // whether to only simulate. The result JSON carries the simulation report and the fee.
    SLOT(QString transferPublic(QString fromHex, QString toHex, QString amountStr, QString feeParamsJson, bool dryRun))
    SLOT(QString transferPrivate(QString fromHex, QString toHex, QString amountStr, QString feeParamsJson, bool dryRun))
    SLOT(QString transferPrivateOwned(QString fromHex, QString toHex, QString amountStr, QString feeParamsJson, bool dryRun))
    SLOT(QString transferShielded(QString fromHex, QString toKeysJson, QString amountStr, QString feeParamsJson, bool dryRun))
    SLOT(QString transferShieldedOwned(QString fromHex, QString toHex, QString amountStr, QString feeParamsJson, bool dryRun))
    SLOT(QString transferDeshielded(QString fromHex, QString toHex, QString amountStr, QString feeParamsJson, bool dryRun))

    SLOT(QString bridgeWithdraw(QString fromHex, QString bedrockAccountPkHex, QString amountStr, QString feeParamsJson, bool dryRun))

    SLOT(QString createNew(QString password, QString sequencerAddr))
    SLOT(QString openExisting(QString configPath, QString storagePath, QString password))
    // Open the saved wallet: "" when it opened or when it can't be opened at all (then the
    // saved location is forgotten and a notice says why), else the reason to show on the form.
    SLOT(QString unlockSaved(QString password))
    // The config.json and storage.json in lez_core's default wallet folder, only when both
    // exist: [config, storage], else empty.
    SLOT(QStringList defaultWalletFiles())

    SLOT(void copyToClipboard(QString text))

    SLOT(bool checkLabelAvailable(QString label))
    SLOT(QString addLabel(QString label, QString accountIdHex, bool isPublic))
}
